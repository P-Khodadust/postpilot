# ---- Core ----
ENVIRONMENT=development                 # development | staging | production
PUBLIC_BASE_URL=https://app.example.com # public https origin for OAuth/webhook callbacks
LOG_LEVEL=INFO

# ---- Datastores ----
DATABASE_URL=postgresql+asyncpg://postpilot:postpilot@db:5432/postpilot
REDIS_URL=redis://redis:6379/0

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=generate-a-random-32+-char-string
TELEGRAM_USE_WEBHOOK=true               # false => long-polling (dev, single replica)

# ---- X (Twitter) official API, OAuth 2.0 PKCE ----
X_CLIENT_ID=replace-me
X_CLIENT_SECRET=replace-me
X_REDIRECT_URI=https://app.example.com/oauth/x/callback
# App-wide monthly post cap for YOUR X API tier (shared across all tenants). Config-driven on purpose.
X_APP_MONTHLY_POST_CAP=450

# ---- Token encryption at rest (MultiFernet, newest key first, comma-separated) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEYS=replace-with-a-fernet-key

# ---- AI (Anthropic Claude) ----
AI_ENABLED=true                         # set false to fully disable AI (no Claude calls; templated fallbacks)
ANTHROPIC_API_KEY=replace-me
AI_MONTHLY_TOKEN_BUDGET_DEFAULT=200000

# ---- Billing: Stripe ----
STRIPE_API_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ---- Billing: Telegram Payments / Stars ----
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=        # empty => Telegram Stars (XTR) only

# ---- Admin dashboard ----
ADMIN_SESSION_SECRET=generate-a-random-secret
ADMIN_IP_ALLOWLIST=                      # optional comma-separated CIDRs

# ---- HTTPS edge (Caddy + DuckDNS DNS-01), optional ----
# When set, the caddy service serves https://<PP_PUBLIC_HOST>:8443 and routes to web.
# Point PUBLIC_BASE_URL / X_REDIRECT_URI at this host:port too.
PP_PUBLIC_HOST=                          # e.g. yourname.duckdns.org
DUCKDNS_TOKEN=                           # from duckdns.org (account token)

# ---- Scheduler ----
SCHEDULER_TICK_SECONDS=10
POST_MAX_LATENESS_MINUTES=120
